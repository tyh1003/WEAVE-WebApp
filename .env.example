# Required for Gemini Refine/Retrieve and optional model-backed features
GEMINI_API_KEY=replace_with_your_api_key

# Flask configuration
APP_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Optional: comma-separated allowed browser origins for cross-device use
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional frontend setting (configure in Vite environment as appropriate)
# VITE_API_BASE_URL=/api
